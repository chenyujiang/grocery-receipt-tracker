# Client-side (safe to expose — anon key only)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only (used inside /api, never referenced from src/) — Section 3.1
SUPABASE_SERVICE_ROLE_KEY=
CLAUDE_API_KEY=

# Shared secret for the scheduled low-stock cron route -- any long random
# string, matched against Vercel Cron's `Authorization: Bearer` header.
# Unset means the route refuses every caller (it fails closed).
CRON_SECRET=
